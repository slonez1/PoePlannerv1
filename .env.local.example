# Gemini API Configuration
API_KEY=your_gemini_api_key_here

# Firebase Authentication Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
# 1. Create a new Firebase project or select an existing one
# 2. Go to Project Settings > General
# 3. Scroll down to "Your apps" section and click on the web app icon
# 4. Copy the config values below

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual Firebase credentials
# 3. Enable Email/Password authentication in Firebase Console:
#    - Go to Authentication > Sign-in method
#    - Enable "Email/Password" provider
# 4. Restart your development server after updating these values
